FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY digital-garage-openai/v2/requirements-v2.txt /app/requirements-v2.txt
RUN pip install --no-cache-dir -r /app/requirements-v2.txt
COPY digital-garage-openai/v2 /app/v2
ENV PYTHONPATH=/app/v2
EXPOSE 8082
CMD ["uvicorn","garage_v2.api:app","--host","0.0.0.0","--port","8082"]
